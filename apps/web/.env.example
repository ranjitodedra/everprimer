NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CHILD_LOGIN_SECRET=
CHILD_LOGIN_EMAIL_DOMAIN=child-login.everprimer.invalid
CRON_SECRET=
GOOGLE_GENERATIVE_AI_API_KEY=
# Set to mock to skip provider calls.
AI_PROVIDER=

# Tutor character art (fal.ai, FLUX.2 Klein 9B). Server only. Without FAL_KEY lessons stay plain text.
FAL_KEY=
LESSON_ART_ENABLED=true
LESSON_ART_MODEL=fal-ai/flux-2/klein/9b
# Image-to-image endpoint that redraws the talking pose as the teaching pose. Defaults to <model>/edit.
LESSON_ART_EDIT_MODEL=
# Background removal for both poses, so the character stands on the page. Defaults to fal-ai/birefnet/v2.
LESSON_ART_CUTOUT_MODEL=
# Characters one account may generate per UTC day; extras wait for the next day.
LESSON_ART_DAILY_LIMIT=40

# Live voice tutor (Gemini Live). Server only; the browser gets a single-use ephemeral token.
# Falls back to GOOGLE_GENERATIVE_AI_API_KEY when unset. Max plan only.
GEMINI_API_KEY=
TUTOR_LIVE_ENABLED=true
TUTOR_LIVE_MODEL=gemini-3.8-live
# Ephemeral tokens are documented for v1alpha in @google/genai.
TUTOR_LIVE_API_VERSION=v1alpha
TUTOR_LIVE_VOICE=Puck

# Stripe. Checkout and the Customer Portal are hosted redirects.
# The publishable key is not loaded by the browser.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_MAX=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Artifact library (Stage 4). ARTIFACT_ORIGIN is the second, cookie-less registrable
# domain library artifacts load from. In dev, 127.0.0.1:3000 shares the same `next dev`
# as the app on localhost but counts as a separate origin, so cookies and storage are
# isolated (see Docs/artifact-library/decisions/ADR-001-artifact-origin.md). Unset means
# "library disabled; fall back to the built-in visual".
ARTIFACT_ORIGIN=http://127.0.0.1:3000
# Signs short-lived draft preview URLs. Any 32+ random bytes, kept secret.
ARTIFACT_DRAFT_SECRET=
